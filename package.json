{
  "name": "kargoenterprise",
  "version": "1.0.0",
  "scripts": {
    "start": "concurrently -c \"blue,green\" -n \"BACKEND,FRONTEND\" \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "kill-port 8000 & cd backend && ..\\venv\\Scripts\\uvicorn app.main:app --reload --port 8000",
    "start:frontend": "cd frontend && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "kill-port": "^2.0.1"
  }
}
