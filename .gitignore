# ============================================================
# KargoEnterprises - .gitignore
# Python (FastAPI) + React (Vite/TypeScript)
# ============================================================

# ─── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# Virtual environments
venv/
env/
.env/
.venv/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# PyInstaller
*.spec

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# mypy / pyright
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/

# ─── Environment & Secrets ──────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ─── Database ───────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ─── Node / npm / React ─────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build output
frontend/dist/
frontend/build/

# TypeScript cache
*.tsbuildinfo

# Vite cache
.vite/

# ─── IDEs & Editors ─────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# ─── OS Generated ───────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Logs ───────────────────────────────────────────────────
logs/
*.log

# ─── Misc ───────────────────────────────────────────────────
*.bak
*.tmp
*.temp
